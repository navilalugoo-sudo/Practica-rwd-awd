<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catálogo - Adaptativo Desktop</title>
  <link rel="stylesheet" href="/css/styless.css">
</head>
<body>
  <header style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 2rem; background-color: #0f172a; color: white;">
    <h1 style="margin: 0; font-size: 1.25rem;">Catálogo de Hardware (AWD - Escritorio)</h1>
    <nav>
      <a href="#" style="color: #f3f4f6; margin-left: 20px; text-decoration: none;">Inicio</a>
      <a href="#" style="color: #f3f4f6; margin-left: 20px; text-decoration: none;">Productos</a>
      <a href="#" style="color: #f3f4f6; margin-left: 20px; text-decoration: none;">Contacto</a>
    </nav>
  </header>

  <main class="layout-container">
    <aside class="sidebar">
      <h2>Filtros</h2>
      
      <div style="margin-bottom: 15px;">
        <label style="display: block; font-size: 0.9rem; margin-bottom: 5px;">Buscar</label>
        <input type="text" placeholder="Nombre del producto" style="width: 100%; padding: 6px; border-radius: 4px; border: 1px solid #ccc;">
      </div>

      <div style="margin-bottom: 15px;">
        <label style="display: block; font-size: 0.9rem; margin-bottom: 5px;">Precio máximo: <strong>$50,000.00</strong></label>
        <input type="range" min="0" max="50000" value="50000" style="width: 100%;">
      </div>

      <div style="margin-bottom: 15px;">
        <label style="display: block; font-size: 0.9rem; margin-bottom: 5px;">RAM mínima</label>
        <select style="width: 100%; padding: 6px; border-radius: 4px; border: 1px solid #ccc;">
          <option>Cualquiera</option>
          <option>16 GB</option>
          <option>32 GB</option>
          <option>64 GB</option>
        </select>
      </div>

      <div style="margin-bottom: 15px;">
        <label style="display: block; font-size: 0.9rem; margin-bottom: 5px;">Almacenamiento mínimo</label>
        <select style="width: 100%; padding: 6px; border-radius: 4px; border: 1px solid #ccc;">
          <option>Cualquiera</option>
          <option>512 GB SSD</option>
          <option>1 TB SSD</option>
        </select>
      </div>

      <button style="width: 100%; padding: 8px; background: transparent; color: white; border: 1px solid rgba(255,255,255,0.4); border-radius: 4px; cursor: pointer; margin-bottom: 25px;">Limpiar filtros</button>

      <h2>Comparación</h2>
      <p style="font-size: 0.85rem; color: #cbd5e1; margin-top: 5px;">Productos.</p>
    </aside>

    <section class="catalog-grid">
      <% products.forEach(product => { %>
        <article class="card">
          <img src="/imagenes/<%= product.image %>" alt="<%= product.title %>">
          
          <h3><%= product.title %></h3>
          
          <table class="specs-table">
            <tr><td><strong>CPU:</strong></td><td><%= product.specs.cpu %></td></tr>
            <tr><td><strong>RAM:</strong></td><td><%= product.specs.ram %></td></tr>
            <tr><td><strong>Almacenamiento:</strong></td><td><%= product.specs.storage %></td></tr>
            <tr><td><strong>Fuente:</strong></td><td><%= product.specs.psu %></td></tr>
          </table>

          <p><strong><%= product.price %></strong></p>
          <button class="btn-buy">Comprar</button>
        </article>
      <% }); %>
    </section>
  </main>
</body>
</html>